# systemd unit for the TSRS panel gateway on a Docker-daemon host.
# (deploy/tsrs-web.container is the podman/Quadlet equivalent -- use one, not both.)
#
# Install:  docker run --rm --user 0 -v /etc/systemd/system:/out \
#             ghcr.io/gemini-rtsw/tsrs_screen:latest \
#             cp /app/deploy/tsrs-web.service /out/tsrs-web.service
#           sudo systemctl daemon-reload && sudo systemctl enable --now tsrs-web
#           (target hosts reach GHCR but not github.com, so the unit ships in
#            the image; `sudo systemctl edit --force --full tsrs-web` also works)
#
# Read "Deploy to production" in README.md before editing anything below.
#
# --network host is REQUIRED. CA name resolution and IOC beacons do not survive
# a bridged/NAT network; on bridge networking the panel sits at NO DATA forever
# with nothing in the log. It also means NO PORT ISOLATION -- TSRS_PORT=8090
# here because 8080 was already taken on the GN host. Check `ss -ltnp` first.
#
# Foreground `docker run --rm`, deliberately NOT --restart=always: systemd owns
# the lifecycle. With both, `systemctl stop` leaves the container running.
#
# CA ADDRESSING -- as shipped this is for a host NOT on the IOC's subnet.
#   Same subnet as the IOC:   -e EPICS_CA_ADDR_LIST="<ioc-bcast>" \
#                             -e EPICS_CA_AUTO_ADDR_LIST=YES \
#   Different subnet (below): -e EPICS_CA_NAME_SERVERS=<ioc-ip>:5064 \
#                             -e EPICS_CA_AUTO_ADDR_LIST=NO \
# Broadcasts do not route between subnets, and unicast UDP to an IOC *host* can
# reach the wrong IOC when several share UDP 5064. README explains both traps,
# the firewall rules, and why TCP name resolution is a workaround rather than a
# design. Verify any change with tools/ca_probe.py before restarting.

[Unit]
Description=TSRS status panel gateway (read-only EPICS CA bridge)
Documentation=https://github.com/gemini-rtsw/tsrs_screen
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=0

Environment=IMAGE=ghcr.io/gemini-rtsw/tsrs_screen:latest

# Pull is best-effort: a registry outage must not stop a working local image
# from starting. Drop the '-' prefix if you would rather fail loudly.
ExecStartPre=-/usr/bin/docker pull ${IMAGE}
ExecStartPre=-/usr/bin/docker rm -f tsrs-web

ExecStart=/usr/bin/docker run --rm --name tsrs-web \
  --network host \
  --read-only \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  -e TSRS_BIND=127.0.0.1 \
  -e TSRS_PORT=8090 \
  -e TSRS_CA_BACKEND=pyepics \
  -e EPICS_CA_NAME_SERVERS=10.2.2.49:5064 \
  -e EPICS_CA_AUTO_ADDR_LIST=NO \
  -e EPICS_CA_MAX_ARRAY_BYTES=160000 \
  -e TSRS_CA_WATCHDOG_S=60 \
  -e TSRS_LOGLEVEL=INFO \
  ${IMAGE}

ExecStop=/usr/bin/docker stop -t 10 tsrs-web

[Install]
WantedBy=multi-user.target
