# Podman Quadlet unit for the TSRS panel gateway on EL9.
#
# Install to /etc/containers/systemd/tsrs-web.container, then:
#     systemctl daemon-reload && systemctl start tsrs-web
# Quadlet generates a real systemd service from this file, which is why podman
# is the better fit than Docker here: no daemon to babysit, and ITOps manage it
# with the same systemctl verbs as everything else.
#
# HOST NETWORKING IS REQUIRED, NOT A PREFERENCE.
# EPICS_CA_ADDR_LIST below is a *broadcast* address. Channel Access resolves
# channel names by UDP broadcast and the IOC sends beacons back; neither
# survives a bridged/NAT network. With bridge networking and
# EPICS_CA_AUTO_ADDR_LIST=YES, libca would derive the podman subnet instead and
# silently resolve nothing -- the panel would show NO DATA forever with no error.
#
# This file assumes the host is ON the control VLAN (10.2.2.0/24), which is the
# intended home for the entrance display node. Off-VLAN hosts cannot use the
# broadcast at all and must switch to TCP name resolution:
#     Environment=EPICS_CA_NAME_SERVERS=10.2.2.49:5064
#     Environment=EPICS_CA_AUTO_ADDR_LIST=NO
# and must NOT set EPICS_CA_ADDR_LIST. Unicast UDP to 10.2.2.49 does not work:
# two IOCs share UDP 5064 there and the wrong one answers. See "Reaching the
# IOC" in README.md and the long comment in deploy/tsrs-web.service.

[Unit]
Description=TSRS status panel gateway (read-only EPICS CA bridge)
Documentation=https://github.com/gemini-rtsw/tsrs_screen
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/gemini-rtsw/tsrs_screen:latest
ContainerName=tsrs-web

Network=host

# Gemini North. For Gemini South use the CP address list.
Environment=EPICS_CA_ADDR_LIST=10.2.2.255 10.2.10.21
Environment=EPICS_CA_AUTO_ADDR_LIST=YES
Environment=EPICS_CA_MAX_ARRAY_BYTES=160000

# Site-standard CA client. Do not switch this to caproto in production without
# agreeing it with the group -- see the Monitor docstring in app.py.
Environment=TSRS_CA_BACKEND=pyepics
Environment=TSRS_LOGLEVEL=INFO

# Bound to loopback: the gateway runs on the display node itself so the failure
# domain stays exactly what it is today (one box). Widen this only with an
# availability plan -- centralising it invents a new way to blank the panel for
# everyone at once.
Environment=TSRS_BIND=127.0.0.1

# Read-only annunciator. No writes to EPICS, no writes to disk.
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target default.target
