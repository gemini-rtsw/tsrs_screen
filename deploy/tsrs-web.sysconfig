# Host overrides for the TSRS panel gateway.  /etc/sysconfig/tsrs-web
#
# %config(noreplace): your edits survive `dnf upgrade`.
#
# Site addressing is chosen automatically from GEMINI_SITE (MK or CP, default
# MK) out of /usr/share/tsrs-screen/site-<SITE>.env. This file is merged on top
# of it, so anything set here WINS. Only put host-specific things here.
#
# Not shell: KEY=VALUE, # comments fine, do NOT quote values (quotes are taken
# literally), no variable expansion. A commented-out line is genuinely unset.
#
# Check what was resolved:  cat /run/tsrs-web.env   (after a start)
# Verify addressing:        tsrs-ca-probe <ioc-ip> bfo:mcsStatus

# --- Listener -------------------------------------------------------------
# --network host means no port isolation: check `ss -ltnp` for a free port.
#
# Loopback by default because the intended home is the entrance display node,
# which runs the browser itself -- the failure domain then stays what it is
# today, one box. Set 0.0.0.0 to reach the panel from another machine (a shared
# docker host, or a parallel-run against CS-Studio). That is a deliberate
# widening: the panel is read-only, but it is unauthenticated on every
# interface, so decide it rather than inherit it.
TSRS_BIND=127.0.0.1
TSRS_PORT=8090

# --- Site override --------------------------------------------------------
# Only if GEMINI_SITE is absent or wrong on this host.
#TSRS_SITE=MK

# --- Addressing override --------------------------------------------------
# The site file assumes the panel host is ON the IOC's subnet (broadcast). A
# host on a different subnet must blank the broadcast and use TCP name
# resolution -- broadcasts do not route, and unicast UDP to an IOC host can
# reach the wrong IOC when several share UDP 5064.
#EPICS_CA_ADDR_LIST=
#EPICS_CA_NAME_SERVERS=10.2.2.49:5064
#EPICS_CA_AUTO_ADDR_LIST=NO
