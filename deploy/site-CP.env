# Gemini South (Cerro Pachon) -- NOT YET CONFIGURED.
#
# The service refuses to start while this line is present. That is deliberate:
# silently falling back to MK would point a readiness screen at the wrong
# telescope's PLC, and a confidently wrong display is the exact failure this
# panel exists to prevent.
TSRS_SITE_UNCONFIGURED=1

# To commission CP, get these from Gemini South controls, verify with
#   tsrs-ca-probe <ioc-ip> <pv>
# then delete the line above:
#
#EPICS_CA_ADDR_LIST=<cp-ioc-subnet-broadcast>
#EPICS_CA_AUTO_ADDR_LIST=YES
#EPICS_CA_MAX_ARRAY_BYTES=160000
#
# Also confirm the PV prefix. The panel's channel list is generated from
# tsrs_indicators.csv, which is baked with the MK `bfo:` names -- if CP uses a
# different prefix the CSVs must be regenerated from CP's .opi files. That is a
# rebuild, not a config change, and no setting in this file can substitute.
