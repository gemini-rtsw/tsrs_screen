# Gemini North (Mauna Kea) -- Channel Access addressing.
# Selected automatically when GEMINI_SITE=MK, and the default when GEMINI_SITE
# is unset. Override any single key in /etc/sysconfig/tsrs-web.
#
# BFO IOC: bfo-mk-ioc on mkosioc-lv1 = 10.2.2.49, subnet 10.2.2.0/24.
# Verified 2026-08-11: all 76 channels connect.

# Default is the normal EPICS setup for a host ON the IOC's subnet, which is
# where the entrance display node belongs. 10.2.10.21 is a second entry of
# unconfirmed purpose, carried over from the original config; extra entries are
# additive and harmless.
EPICS_CA_ADDR_LIST=10.2.2.255 10.2.10.21
EPICS_CA_AUTO_ADDR_LIST=YES

EPICS_CA_MAX_ARRAY_BYTES=160000

# OFF-SUBNET HOSTS (e.g. 10.2.71.0/24) must override in /etc/sysconfig/tsrs-web:
#   EPICS_CA_ADDR_LIST=
#   EPICS_CA_NAME_SERVERS=10.2.2.49:5064
#   EPICS_CA_AUTO_ADDR_LIST=NO
# Blanking ADDR_LIST matters -- broadcasts do not route, and unicast UDP to the
# IOC host can reach the wrong IOC. See "Reaching the IOC" in the README.
